{
  "name": "platformforgames",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=web",
    "preview": "npm run preview --workspace=web",
    "test": "node --experimental-strip-types --no-warnings --test 'web/src/**/*.test.ts' 'server/src/**/*.test.js'",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  },
  "engines": {
    "node": ">=22.5"
  }
}
